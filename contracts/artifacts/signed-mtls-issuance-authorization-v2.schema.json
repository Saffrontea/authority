{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/signed-mtls-issuance-authorization-v2.schema.json",
  "title": "SignedMtlsIssuanceAuthorizationV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "key_id",
    "signature",
    "generation",
    "authorization"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:@-]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "generation": {
      "$ref": "generation-binding-v1.schema.json"
    },
    "authorization": {
      "$ref": "mtls-issuance-authorization-v1.schema.json"
    }
  }
}
