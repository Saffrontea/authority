{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/signed-identity-revocation-command-v1.schema.json",
  "title": "SignedIdentityRevocationCommandV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "algorithm",
    "key_id",
    "signature"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:@-]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "command": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://authority.invalid/contracts/identity-revocation-command-v1.schema.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "domain_id",
        "selector",
        "nonce",
        "reason",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:@-]+$"
        },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "subject_user_id"
              ],
              "properties": {
                "kind": {
                  "const": "subject"
                },
                "subject_user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:@-]+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "device_id"
              ],
              "properties": {
                "kind": {
                  "const": "device"
                },
                "device_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:@-]+$"
                }
              }
            }
          ]
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:@-]+$"
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
