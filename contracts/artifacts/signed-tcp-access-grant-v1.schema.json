{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/signed-tcp-access-grant-v1.schema.json",
  "title": "SignedTcpAccessGrantV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "algorithm",
    "key_id",
    "signature"
  ],
  "properties": {
    "grant": {
      "$ref": "tcp-access-grant-v1.schema.json"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:@-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 80,
      "maxLength": 128
    }
  }
}
