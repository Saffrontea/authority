{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/policy-plan-evaluated-v2.schema.json",
  "title": "PolicyPlanEvaluatedV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "planning"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "planning": {
      "$ref": "#/$defs/planning"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "subject_user_id",
        "device_id",
        "target_node_id"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_node_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before",
        "expires_at"
      ],
      "properties": {
        "not_before": {
          "type": "integer"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scoped_ability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "validity",
        "scope"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "wireguard_public_key",
                "address"
              ],
              "properties": {
                "kind": {
                  "const": "mesh_membership"
                },
                "wireguard_public_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "address": {
                  "type": "string",
                  "format": "ipv4"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "destination"
              ],
              "properties": {
                "kind": {
                  "const": "network_reachability"
                },
                "source": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "destination": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "public_key_fingerprint",
                "principals",
                "terminal_token_hash"
              ],
              "properties": {
                "kind": {
                  "const": "ssh_session"
                },
                "public_key_fingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "principals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "terminal_token_hash": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "client_spki_sha256",
                "identity_uri",
                "service_audience"
              ],
              "properties": {
                "kind": {
                  "const": "service_identity"
                },
                "client_spki_sha256": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "identity_uri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "service_audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "destination",
                "ports"
              ],
              "properties": {
                "kind": {
                  "const": "tcp_connection"
                },
                "source": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "destination": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "ports": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/port_set",
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "destination"
              ],
              "properties": {
                "kind": {
                  "const": "network_route_authorization"
                },
                "source": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "destination": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "public_key_fingerprint",
                "principals",
                "terminal_token_hash"
              ],
              "properties": {
                "kind": {
                  "const": "ssh_credential"
                },
                "public_key_fingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "principals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "terminal_token_hash": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "client_spki_sha256",
                "identity_uri",
                "service_audience"
              ],
              "properties": {
                "kind": {
                  "const": "mtls_credential"
                },
                "client_spki_sha256": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "identity_uri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "service_audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "destination",
                "ports"
              ],
              "properties": {
                "kind": {
                  "const": "tcp_admission"
                },
                "source": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "destination": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
                  "minItems": 1
                },
                "ports": {
                  "$ref": "tcp-resources-v1.schema.json#/$defs/port_set",
                  "minItems": 1
                }
              }
            }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "revision"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ability_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ability",
        "permitted",
        "policies"
      ],
      "properties": {
        "ability": {
          "$ref": "#/$defs/scoped_ability"
        },
        "permitted": {
          "$ref": "#/$defs/scoped_ability"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policy"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "requires",
        "provides"
      ],
      "properties": {
        "mechanism": {
          "enum": [
            "wireguard_peer",
            "network_route",
            "ssh_certificate",
            "mtls_certificate",
            "tcp_admission"
          ]
        },
        "requires": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "provides": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abilities",
        "goals",
        "steps",
        "derivations"
      ],
      "properties": {
        "abilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ability_evidence"
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "derivations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/derivation"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "result"
      ],
      "properties": {
        "candidate": {
          "enum": [
            "existing_route",
            "wireguard_mesh"
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "mechanism_count",
                "plan"
              ],
              "properties": {
                "status": {
                  "const": "authorized"
                },
                "mechanism_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "plan": {
                  "$ref": "#/$defs/plan"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "capability"
              ],
              "properties": {
                "status": {
                  "const": "rejected"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "capability": {
                  "anyOf": [
                    {
                      "enum": [
                        "mesh.join",
                        "network.reach",
                        "ssh.issue",
                        "mtls.issue",
                        "tcp.connect"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "binding",
        "evaluated_at",
        "outcomes",
        "route_choice",
        "selection_rule",
        "candidates",
        "selected",
        "plan",
        "resources",
        "deployment"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "evaluated_at": {
          "type": "integer",
          "minimum": 0
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ssh",
              "network.reachability",
              "mtls.service",
              "tcp.connect"
            ]
          }
        },
        "route_choice": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "route"
              ],
              "properties": {
                "mode": {
                  "const": "exact"
                },
                "route": {
                  "enum": [
                    "direct",
                    "mesh_required"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "automatic"
                }
              }
            }
          ]
        },
        "selection_rule": {
          "const": "minimal_authority_then_fewest_mechanisms_then_candidate_id"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "selected": {
          "anyOf": [
            {
              "enum": [
                "existing_route",
                "wireguard_mesh"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/plan"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/resources"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/$defs/deployment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_address",
        "target_address",
        "registered_wireguard_key",
        "service_audience",
        "environment"
      ],
      "properties": {
        "source_address": {
          "type": "string",
          "format": "ipv4"
        },
        "target_address": {
          "type": "string",
          "format": "ipv4"
        },
        "registered_wireguard_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "service_audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "enum": [
              "ssh_ca_trusted",
              "mtls_ca_trusted",
              "tcp_enforcement",
              "mesh_route_configured",
              "existing_route_configured"
            ]
          }
        },
        "observation": {
          "$ref": "endpoint-observation-v2.schema.json"
        }
      }
    },
    "existing_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "registered_wireguard_key"
      ],
      "properties": {
        "source": {
          "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
          "minItems": 1
        },
        "destination": {
          "$ref": "tcp-resources-v1.schema.json#/$defs/ipv4_set",
          "minItems": 1
        },
        "registered_wireguard_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existing_route",
        "wireguard_target"
      ],
      "properties": {
        "existing_route": {
          "anyOf": [
            {
              "$ref": "#/$defs/existing_route"
            },
            {
              "type": "null"
            }
          ]
        },
        "wireguard_target": {
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_mechanisms",
        "requires",
        "provides"
      ],
      "properties": {
        "after_mechanisms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    }
  }
}
