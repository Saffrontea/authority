{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge",
    "key_id",
    "signature"
  ],
  "properties": {
    "challenge": {
      "$ref": "#/$defs/challenge"
    },
    "key_id": {
      "$ref": "#/$defs/identifier"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/endpoint-challenge-v1.schema.json",
  "title": "SignedEndpointChallengeV1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:@-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "domain_id",
        "target_node_id",
        "nonce",
        "revision",
        "issued_at",
        "expires_at",
        "resources"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "audience": {
          "const": "authority.endpoint.observe.v1"
        },
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_node_id": {
          "$ref": "#/$defs/identifier"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "target",
            "principal",
            "ssh_ca_fingerprints",
            "mtls_ca_sha256",
            "service_audience"
          ],
          "properties": {
            "source": {
              "type": "string",
              "format": "ipv4"
            },
            "target": {
              "type": "string",
              "format": "ipv4"
            },
            "principal": {
              "$ref": "#/$defs/identifier"
            },
            "ssh_ca_fingerprints": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/_-]{43}$"
              }
            },
            "mtls_ca_sha256": {
              "$ref": "#/$defs/digest"
            },
            "service_audience": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    }
  }
}
