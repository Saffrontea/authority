{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/policy-decision-evaluated-v1.schema.json",
  "title": "PolicyDecisionEvaluatedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "intent",
    "required_capabilities",
    "policy_sources",
    "adapter_grants"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "route"],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ssh", "network.reachability"] }
        },
        "route": { "enum": ["direct", "mesh_required"] }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ssh.issue", "mesh.join", "network.reach"] }
    },
    "policy_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "policy_id", "revision"],
        "properties": {
          "capability": { "enum": ["ssh.issue", "mesh.join", "network.reach"] },
          "policy_id": { "type": "string", "format": "uuid" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "adapter_grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "audience", "expires_at"],
        "properties": {
          "kind": { "enum": ["ssh.certificate", "wireguard.peer"] },
          "audience": { "type": "string", "minLength": 1, "maxLength": 128 },
          "expires_at": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
