{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authority.invalid/contracts/signed-decision-revocation-notice-v1.schema.json",
  "title": "SignedDecisionRevocationNoticeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["notice", "algorithm", "key_id", "signature"],
  "properties": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "issuer", "domain_id", "target_node_id", "decision_id", "reason", "sequence", "revoked_at", "expires_at", "audience"],
      "properties": {
        "version": { "const": "1" },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
        "domain_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
        "target_node_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
        "decision_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "revoked_at": { "type": "integer", "minimum": 0 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "audience": { "const": "network-agent" }
      }
    },
    "algorithm": { "const": "Ed25519" },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:@-]+$" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
