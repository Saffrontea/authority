# Local mise configuration may contain development secrets.
mise.local.toml

# Optional environment files are local-only.
.env
.env.*
!.env.example

# Locally generated development secrets.
.secrets/

# Rust build output.
target/

# Sandbox-local dependency cache.
.cache/

# Python bytecode generated by local checks.
__pycache__/
*.py[cod]

# Assistant/runtime metadata mounts are never project sources.
.agents/
.aws/
.codex/
