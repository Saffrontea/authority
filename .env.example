# Optional. If neither value is set, agent:serve generates a local secret in
# .secrets/authority-db-password.
AUTHORITY_DB_PASSWORD=

# Instead of putting the value in the environment, point to a one-line file.
# AUTHORITY_DB_PASSWORD_FILE=/absolute/path/to/authority-db-password

# Control Plane defaults are suitable for http://localhost:3000.
AUTHORITY_BIND=127.0.0.1:3000
AUTHORITY_DOMAIN_ID=019a6e6d-4b01-7c31-bb4c-f83220bec001
AUTHORITY_RP_ID=localhost
AUTHORITY_RP_NAME=Authority PoC
AUTHORITY_RP_ORIGIN=http://localhost:3000

# If omitted, scripts/run-control-plane.sh generates this file locally.
# AUTHORITY_BOOTSTRAP_TOKEN_FILE=/absolute/path/to/authority-bootstrap-token
# AUTHORITY_SIGNING_KEY_FILE=/absolute/path/to/control-plane-ed25519.pem
# AUTHORITY_SIGNING_PUBLIC_KEY_FILE=/absolute/path/to/control-plane-ed25519.pub.pem
AUTHORITY_SIGNING_KEY_ID=control-plane-key-1

AUTHORITY_ISSUER_BIND=127.0.0.1:3001
AUTHORITY_CONTROL_PLANE_KEY_ID=control-plane-key-1
# AUTHORITY_CONTROL_PLANE_PUBLIC_KEY_FILE=/absolute/path/to/control-plane-ed25519.pub.pem
# AUTHORITY_SSH_CA_KEY_FILE=/absolute/path/to/ssh-ca
# AUTHORITY_SSH_CA_PUBLIC_KEY_FILE=/absolute/path/to/ssh-ca.pub

AUTHORITY_NODE_AGENT_BIND=127.0.0.1:3002
# AUTHORITY_NODE_SSH_KEY_FILE=/absolute/path/to/id_ed25519
# AUTHORITY_NODE_SSH_CERT_FILE=/absolute/path/to/id_ed25519-cert.pub
